<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Love Test IA 💖</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  color: white;
  text-align: center;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: radial-gradient(circle at top, #ff4da6, #ff0066, #99004d);
}

h1 {
  margin-top: 40px;
  text-shadow: 0 0 20px #ff99cc;
}

.card {
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(15px);
  padding: 30px;
  border-radius: 20px;
  display: inline-block;
  margin-top: 20px;
}

input {
  padding: 10px;
  margin: 5px;
  border-radius: 10px;
  border: none;
  width: 200px;
}

button {
  margin-top: 15px;
  padding: 10px 25px;
  border-radius: 20px;
  border: none;
  background: linear-gradient(45deg, #ff99cc, #ff0066);
  color: white;
  font-weight: bold;
  cursor: pointer;
}

/* loader cercle */
#loader {
  display: none;
  margin-top: 40px;
}

.circle {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  border: 5px solid rgba(255,255,255,0.2);
  border-top: 5px solid #ff99cc;
  margin: auto;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {transform: rotate(0deg);}
  100% {transform: rotate(360deg);}
}

#loadingText {
  margin-top: 15px;
  font-size: 20px;
}

/* résultat */
#result {
  margin-top: 20px;
  font-size: 22px;
  font-weight: bold;
}

#shareBtn {
  display: none;
  margin-top: 20px;
  background: #25D366;
}

/* BKG SERVICE bouton */
#bkgBtn {
  margin-top: 20px;
  background: #ff0066;
  color: white;
  font-weight: bold;
  padding: 10px 25px;
  border-radius: 20px;
  text-decoration: none;
  display: inline-block;
  margin-bottom: 20px;
}
</style>

</head>
<body>

<div>
<h1>💖 Love Test IA 💖</h1>

<div class="card" id="formBox">

  <h2>👩 Fille</h2>
  <input type="text" id="girlName" placeholder="Nom de la fille"><br>
  <input type="number" id="girlAge" placeholder="Âge de la fille"><br>

  <h2>👨 Garçon</h2>
  <input type="text" id="boyName" placeholder="Nom du garçon"><br>
  <input type="number" id="boyAge" placeholder="Âge du garçon"><br>

  <button onclick="testLove()">Analyser ❤️</button>

</div>

<div id="loader">
  <div class="circle"></div>
  <div id="loadingText">Initialisation IA...</div>
</div>

<div id="result"></div>
<button id="shareBtn" onclick="shareWhatsApp()">Partager sur WhatsApp 📤</button>
</div>

<!-- BKG SERVICE tout en bas -->
<div>
  <a href="tel:+22674788339" id="bkgBtn">📞 BKG SERVICE +22674788339</a>
</div>

<script>

// 🔥 score fixe
function generateScore(text) {
  let hash = 0;
  for (let i = 0; i < text.length; i++) {
    hash = text.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash % 101);
}

function testLove() {

  let girl = document.getElementById("girlName").value;
  let boy = document.getElementById("boyName").value;
  let ageGirl = document.getElementById("girlAge").value;
  let ageBoy = document.getElementById("boyAge").value;

  if(girl === "" || boy === "" || ageGirl === "" || ageBoy === "") {
    alert("Remplis tous les champs !");
    return;
  }

  document.getElementById("formBox").style.display = "none";
  document.getElementById("loader").style.display = "block";

  let key = girl + boy + ageGirl + ageBoy;
  let score = generateScore(key);

  let messagesIA = [
    "🔍 Analyse des émotions...",
    "💓 Lecture des cœurs...",
    "🧠 Calcul de compatibilité...",
    "💘 Vérification des sentiments...",
    "⚡ Synchronisation amoureuse..."
  ];

  let i = 0;
  let interval = setInterval(() => {
    document.getElementById("loadingText").innerText = messagesIA[i];
    i = (i + 1) % messagesIA.length;
  }, 800);

  let message = "";
  if(score > 80) message = "🔥 Âmes sœurs détectées !";
  else if(score > 50) message = "💘 Bonne connexion émotionnelle";
  else message = "😅 Compatibilité faible détectée";

  setTimeout(() => {

    clearInterval(interval);
    document.getElementById("loader").style.display = "none";

    let resultText =
      girl + " (" + ageGirl + " ans) ❤️ " + boy + " (" + ageBoy + " ans)\n" +
      "Compatibilité : " + score + "% - " + message;

    document.getElementById("result").innerHTML =
      resultText.replace(/\n/g, "<br>");

    // afficher bouton WhatsApp
    document.getElementById("shareBtn").style.display = "inline-block";

    // stocker pour partage
    window.finalResult = resultText;

  }, 4000);
}

// 📤 partager WhatsApp
function shareWhatsApp() {
  let url = "https://wa.me/?text=" + encodeURIComponent(window.finalResult + "\nTeste aussi ici 🔥");
  window.open(url, "_blank");
}

</script>

</body>
</html>
